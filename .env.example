# Copy to .env.local and adjust as needed.
# This is the development default: the MongoDB container from docker-compose.yml.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=gym_tracker

# There is no second "target" setting — the app only ever reads MONGODB_URI, and
# which database that points at is decided by the environment, not by the code.
#
#   local dev   .env.local (this file, copied)     -> npm run dev
#   Atlas       .env.atlas.local (gitignored)      -> npm run dev:atlas
#   production  MONGODB_URI in the Render dashboard
#
# To run locally against Atlas, create .env.atlas.local with the SRV string from
# Atlas > Connect > Drivers. Keep MONGODB_DB the same so both point at the same
# database name:
#
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority
#   MONGODB_DB=gym_tracker
#
# `npm run seed` refuses to run against a non-local URI without --force, because
# it deletes every exercise and workout first.
